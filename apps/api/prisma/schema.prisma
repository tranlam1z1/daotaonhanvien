  shuffleOptions Boolean @default(false) @map("shuffle_options")
  showAnswers Boolean @default(false) @map("show_answers")
  questions QuizQuestion[]

  @@unique([tenantId, id])
  @@map("quizzes")
}

enum AssessmentQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum QuizSelectionMode {
  FIXED
  RANDOM
}

model AssessmentQuestion {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  tenant         Tenant                 @relation(fields: [tenantId], references: [id])
  departmentId   String?                @map("department_id") @db.Uuid
  department     Department?            @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: NoAction)
  courseId       String?                @map("course_id") @db.Uuid
  course         TrainingCourse?        @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: NoAction)
  topic          String?
  type           AssessmentQuestionType
  prompt         String
  options        String[]
  correctOptions Int[]                  @map("correct_options")
  explanation    String
  quizzes        QuizQuestion[]

  @@unique([tenantId, id])
  @@index([tenantId, departmentId])
  @@index([tenantId, courseId])
  @@map("assessment_questions")
}

model QuizQuestion {
  tenantId   String             @map("tenant_id") @db.Uuid
  quizId     String             @map("quiz_id") @db.Uuid
  questionId String             @map("question_id") @db.Uuid
  position   Int
  quiz       Quiz               @relation(fields: [tenantId, quizId], references: [tenantId, id], onDelete: Cascade)
  question   AssessmentQuestion @relation(fields: [tenantId, questionId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, quizId, questionId])
  @@unique([tenantId, quizId, position])
  @@index([tenantId, questionId])
  @@map("quiz_questions")
}

