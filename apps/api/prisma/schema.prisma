datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum LeadStatus {
  NEW
  CONTACTED
  DEMOED
  PILOT
  NOT_SUITABLE
}

// Platform data: exempt from tenant RLS.
model Lead {
  id                 String     @id @default(uuid()) @db.Uuid
  fullName           String     @map("full_name") @db.VarChar(200)
  jobTitle           String     @map("job_title") @db.VarChar(200)
  companyName        String     @map("company_name") @db.VarChar(300)
  companySize        String     @map("company_size") @db.VarChar(20)
  phone              String     @db.VarChar(20)
  consent            Boolean
  status             LeadStatus @default(NEW)
  notes              String?
  assigneeId         String?    @map("assignee_id") @db.Uuid
  tenantId           String?    @map("tenant_id") @db.Uuid
  ip                 String     @db.VarChar(45)
  submittedAt        DateTime   @default(now()) @map("submitted_at") @db.Timestamptz(3)
  notificationSentAt DateTime?  @map("notification_sent_at") @db.Timestamptz(3)

  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  assignee User?   @relation(fields: [assigneeId], references: [id])

  @@index([notificationSentAt, submittedAt])
  @@map("leads")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  PENDING
  ACTIVE
  HANDOVER
  DISABLED
}

enum Role {
  QTNT
  ADM
  PTDT
  PD
  NV
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Plan {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  maxAccounts   Int            @map("max_accounts")
  storageGb     Int            @map("storage_gb")
  price         Decimal        @db.Decimal(18, 2)
  cycle         BillingCycle
  subscriptions Subscription[]

  @@map("plans")
}

model Tenant {
  assignmentRules AssignmentRule[]
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @unique @map("tenant_id") @db.Uuid
  name            String
  taxCode         String?          @map("tax_code")
  contactName     String?          @map("contact_name")
  contactPhone    String?          @map("contact_phone")
  initialAdminId  String?          @map("initial_admin_id") @db.Uuid
  address         String?
  logo            String?
  loginCode       String           @unique @map("login_code")
  status          TenantStatus     @default(ACTIVE)
  config          Json             @default("{}")
  storageUsedBytes BigInt           @default(0) @map("storage_used_bytes")
  subscriptions   Subscription[]
  payments        Payment[]
  departments     Department[]
  positions       Position[]
  users           User[]
  roles           UserRole[]
  auditLogs       AuditLog[]
  authCredentials AuthCredential[]
  leads           Lead[]
  fileObjects     FileObject[]
  knowledgeCategories KnowledgeCategory[]
  knowledgeTags KnowledgeTag[]
  knowledgeItems KnowledgeItem[]
  knowledgeVersions KnowledgeVersion[]
  trainingPrograms TrainingProgram[]
  trainingCourses TrainingCourse[]
  trainingModules TrainingModule[]
  trainingLessons TrainingLesson[]
  enrollments Enrollment[]
  lessonProgress LessonProgress[]
  quizAttempts QuizAttempt[]
  practiceResults PracticeResult[]
  courseSurveyResponses CourseSurveyResponse[]
  programCourses ProgramCourse[]
  quizzes Quiz[]
  assessmentQuestions AssessmentQuestion[]
  knowledgeAttachments KnowledgeAttachment[]
  knowledgeRejections KnowledgeRejection[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@map("tenants")
}

model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  planId           String             @map("plan_id") @db.Uuid
  plan             Plan               @relation(fields: [planId], references: [id])
  startsAt         DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime           @map("ends_at") @db.Timestamptz(3)
  status           SubscriptionStatus @default(ACTIVE)
  billableAccounts Int                @default(0) @map("billable_accounts")
  payments         Payment[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("subscriptions")
}

model Payment {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  subscriptionId String       @map("subscription_id") @db.Uuid
  subscription   Subscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id])
  amount         Decimal      @db.Decimal(18, 2)
  paidAt         DateTime     @map("paid_at") @db.Timestamptz(3)
  notes          String?
  recordedBy     String       @map("recorded_by") @db.Uuid
  recorder       User         @relation("PaymentRecorder", fields: [recordedBy], references: [id])

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@map("payments")
}

model Department {
  assignmentRules AssignmentRule[]
  id       String       @id @default(uuid()) @db.Uuid
  tenantId String       @map("tenant_id") @db.Uuid
  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  name     String
  parentId String?      @map("parent_id") @db.Uuid
  parent   Department?  @relation("DepartmentTree", fields: [tenantId, parentId], references: [tenantId, id])
  children Department[] @relation("DepartmentTree")
  status   RecordStatus @default(ACTIVE)
  users    User[]
  trainingPrograms TrainingProgram[]
  trainingCourses TrainingCourse[]
  quizzes Quiz[]
  assessmentQuestions AssessmentQuestion[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("departments")
}

model Position {
  assignmentRules AssignmentRule[]
  id       String       @id @default(uuid()) @db.Uuid
  tenantId String       @map("tenant_id") @db.Uuid
  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  name     String
  status   RecordStatus @default(ACTIVE)
  users    User[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("positions")
}

model User {
  id                    String           @id @default(uuid()) @db.Uuid
  tenantId              String?          @map("tenant_id") @db.Uuid
  tenant                Tenant?          @relation(fields: [tenantId], references: [id])
  employeeCode          String?          @map("employee_code")
  fullName              String           @map("full_name")
  email                 String
  phone                 String?
  passwordHash          String           @map("password_hash")
  invitationRequired   Boolean          @default(false) @map("invitation_required")
  failedLogins          Int              @default(0) @map("failed_logins")
  lockedUntil           DateTime?        @map("locked_until") @db.Timestamptz(3)
  departmentId          String?          @map("department_id") @db.Uuid
  department            Department?      @relation(fields: [tenantId, departmentId], references: [tenantId, id])
  positionId            String?          @map("position_id") @db.Uuid
  position              Position?        @relation(fields: [tenantId, positionId], references: [tenantId, id])
  managerId             String?          @map("manager_id") @db.Uuid
  manager               User?            @relation("UserManager", fields: [tenantId, managerId], references: [tenantId, id])
  reports               User[]           @relation("UserManager")
  handoverCases         HandoverCase[]   @relation("HandoverEmployee")
  joinedAt              DateTime?        @map("joined_at") @db.Date
  leftAt                DateTime?        @map("left_at") @db.Date
  workspaceNotices      WorkspaceNotice[]
  mutedEmailGroups      String[]         @default([]) @map("muted_email_groups")
  status                UserStatus       @default(PENDING)
  roles                 UserRole[]
  leads                 Lead[]
  payments              Payment[]        @relation("PaymentRecorder")
  auditLogs             AuditLog[]
  knowledgeRejections   KnowledgeRejection[]
  trainingRejections TrainingRejection[]
  enrollments Enrollment[] @relation("EnrollmentLearner")
  assignedEnrollments Enrollment[] @relation("EnrollmentAssigner")
  authCredentials       AuthCredential[] @relation("CredentialUser")
  scopedAuthCredentials AuthCredential[] @relation("CredentialScopedUser")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@map("users")
}

model HandoverCase {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  employee    User     @relation("HandoverEmployee", fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  departureOn DateTime @map("departure_on") @db.Date
  dueOn       DateTime @map("due_on") @db.Date
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  workflow    Json @default("{}")

  @@index([tenantId, employeeId])
  @@map("handover_cases")
}

model WorkspaceNotice {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  eventKey String @map("event_key")
  message String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt DateTime? @map("read_at") @db.Timestamptz(3)
  emailHandledAt DateTime? @map("email_handled_at") @db.Timestamptz(3)
  emailClaimedAt DateTime? @map("email_claimed_at") @db.Timestamptz(3)

  @@unique([tenantId, userId, eventKey])
  @@index([tenantId, userId, createdAt])
  @@map("workspace_notices")
}

enum AuthCredentialKind {
  SESSION
  RESET
  INVITE
}

model AuthCredential {
  digest     String             @id
  tenantId   String?            @map("tenant_id") @db.Uuid
  tenant     Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String             @map("user_id") @db.Uuid
  user       User               @relation("CredentialUser", fields: [userId], references: [id], onDelete: Cascade)
  scopedUser User?              @relation("CredentialScopedUser", fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  kind       AuthCredentialKind
  expiresAt  DateTime           @map("expires_at") @db.Timestamptz(3)

  @@index([userId, kind])
  @@index([tenantId])
  @@map("auth_credentials")
}

model UserRole {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String?  @map("tenant_id") @db.Uuid
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
  userId        String   @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id])
  role          Role
  departmentIds String[] @default([]) @map("department_ids") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([userId, role])
  @@index([tenantId])
  @@map("user_roles")
}

model FileObject {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  contentType String   @map("content_type")
  sizeBytes   BigInt   @map("size_bytes")
  storageKey  String   @unique @map("storage_key")
  searchText  String?  @map("search_text")
  trainingLessons TrainingLesson[]
  knowledgeAttachments KnowledgeAttachment[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String   @map("created_by") @db.Uuid

  @@unique([tenantId, id])
  @@map("file_objects")
}

enum KnowledgeStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum KnowledgeAudience {
  TENANT
  DEPARTMENTS
  POSITIONS
}

model KnowledgeCategory {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  name String
  parentId String? @map("parent_id") @db.Uuid
  parent KnowledgeCategory? @relation("KnowledgeTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: NoAction)
  children KnowledgeCategory[] @relation("KnowledgeTree")
  versions KnowledgeVersion[]
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@map("knowledge_categories")
}

model KnowledgeTag {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  name String
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@map("knowledge_tags")
}

model KnowledgeItem {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  createdBy String @map("created_by") @db.Uuid
  versions KnowledgeVersion[]
  trainingLessons TrainingLesson[]

  @@unique([tenantId, id])
  @@map("knowledge_items")
}

model KnowledgeVersion {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  itemId String @map("item_id") @db.Uuid
  item KnowledgeItem @relation(fields: [tenantId, itemId], references: [tenantId, id])
  revision Int @default(1)
  status KnowledgeStatus @default(DRAFT)
  createdBy String @map("created_by") @db.Uuid
  reviewToken String? @map("review_token") @db.Uuid
  rejectionReason String? @map("rejection_reason")
  rejections KnowledgeRejection[]
  title String
  summary String
  bodyHtml String @map("body_html")
  categoryId String? @map("category_id") @db.Uuid
  category KnowledgeCategory? @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: NoAction)
  tagIds String[] @default([]) @map("tag_ids") @db.Uuid
  audience KnowledgeAudience
  departmentIds String[] @default([]) @map("department_ids") @db.Uuid
  positionIds String[] @default([]) @map("position_ids") @db.Uuid
  videoUrl String? @map("video_url")
  attachments KnowledgeAttachment[]
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, itemId, revision])
  @@map("knowledge_versions")
}

model KnowledgeRejection {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [tenantId, userId], references: [tenantId, id])
  versionId String @map("version_id") @db.Uuid
  version KnowledgeVersion @relation(fields: [tenantId, versionId], references: [tenantId, id], onDelete: Cascade)
  title String
  reason String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, userId, createdAt])
  @@map("knowledge_rejections")
}

model KnowledgeAttachment {
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  versionId String @map("version_id") @db.Uuid
  version KnowledgeVersion @relation(fields: [tenantId, versionId], references: [tenantId, id], onDelete: Cascade)
  fileId String @map("file_id") @db.Uuid
  file FileObject @relation(fields: [tenantId, fileId], references: [tenantId, id])
  video Boolean @default(false)

  @@id([tenantId, versionId, fileId])
  @@map("knowledge_attachments")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  objectType String   @map("object_type")
  objectId   String?  @map("object_id") @db.Uuid
  before     Json?
  after      Json?
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  ip         String?  @db.VarChar(45)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@map("audit_logs")
}

enum TrainingProgramType {
  ONBOARDING
  SPECIALIST
}

enum TrainingTargetUnit {
  DAYS
  HOURS
}

enum TrainingCourseStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
}

enum TrainingLearningMode {
  SEQUENTIAL
  FREE
}

enum TrainingLessonType {
  TEXT
  DOCUMENT
  VIDEO
  KNOWLEDGE
  QUIZ
}

model TrainingProgram {
  assignmentRules AssignmentRule[]
  templateSource Json? @map("template_source")
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  departmentId String? @map("department_id") @db.Uuid
  department Department? @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: NoAction)
  name String
  description String
  audience String
  type TrainingProgramType
  targetDuration Int @map("target_duration")
  targetUnit TrainingTargetUnit @map("target_unit")
  revision Int @default(1)
  status TrainingCourseStatus @default(DRAFT)
  authorId String? @map("author_id") @db.Uuid
  reviewToken String? @map("review_token") @db.Uuid
  rejectionReason String? @map("rejection_reason")
  releases TrainingRelease[]
  courses ProgramCourse[]
  enrollments Enrollment[]

  @@unique([tenantId, id])
  @@map("training_programs")
}

model TrainingCourse {
  assignmentRules AssignmentRule[]
  templateSource Json? @map("template_source")
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  departmentId String? @map("department_id") @db.Uuid
  department Department? @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: NoAction)
  name String
  description String
  status TrainingCourseStatus @default(DRAFT)
  completion Json?
  learningMode TrainingLearningMode @default(SEQUENTIAL) @map("learning_mode")
  revision Int @default(1)
  authorId String? @map("author_id") @db.Uuid
  reviewToken String? @map("review_token") @db.Uuid
  rejectionReason String? @map("rejection_reason")
  releases TrainingRelease[]
  programs ProgramCourse[]
  modules TrainingModule[]
  enrollments Enrollment[]

  assessmentQuestions AssessmentQuestion[]

  @@unique([tenantId, id])
  @@map("training_courses")
}

model TrainingRelease {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  courseId String? @map("course_id") @db.Uuid
  course TrainingCourse? @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Cascade)
  programId String? @map("program_id") @db.Uuid
  program TrainingProgram? @relation(fields: [tenantId, programId], references: [tenantId, id], onDelete: Cascade)
  departmentId String? @map("department_id") @db.Uuid
  revision Int
  content Json
  enrollments Enrollment[]

  @@unique([tenantId, courseId, id], map: "training_releases_tenant_id_course_id_id_key")
  @@unique([tenantId, courseId, revision])
  @@unique([tenantId, programId, revision])
  @@map("training_releases")
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  OVERDUE
  COMPLETED
  FAILED
  CANCELLED
}

enum EnrollmentSource {
  MANUAL
  AUTOMATIC
}

model Enrollment {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction)
  userId String @map("user_id") @db.Uuid
  user User @relation("EnrollmentLearner", fields: [tenantId, userId], references: [tenantId, id], onDelete: NoAction)
  courseId String @map("course_id") @db.Uuid
  course TrainingCourse @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: NoAction)
  courseVersionId String @map("course_version_id") @db.Uuid
  courseVersion TrainingRelease @relation(fields: [tenantId, courseId, courseVersionId], references: [tenantId, courseId, id], onDelete: NoAction)
  programId String? @map("program_id") @db.Uuid
  program TrainingProgram? @relation(fields: [tenantId, programId], references: [tenantId, id], onDelete: NoAction)
  ruleId String? @map("rule_id") @db.Uuid
  rule AssignmentRule? @relation(fields: [tenantId, ruleId], references: [tenantId, id], onDelete: NoAction)
  previousEnrollmentId String? @map("previous_enrollment_id") @db.Uuid
  previousEnrollment Enrollment? @relation("ReassignedEnrollment", fields: [tenantId, userId, courseId, previousEnrollmentId], references: [tenantId, userId, courseId, id], onDelete: NoAction)
  reassignedEnrollments Enrollment[] @relation("ReassignedEnrollment")
  assignedById String? @map("assigned_by_id") @db.Uuid
  assignedBy User? @relation("EnrollmentAssigner", fields: [tenantId, assignedById], references: [tenantId, id], onDelete: NoAction)
  source EnrollmentSource
  status EnrollmentStatus @default(NOT_STARTED)
  progressPercent Int @default(0) @map("progress_percent")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  dueAt DateTime @map("due_at") @db.Timestamptz(3)
  startedAt DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  progressInheritedAt DateTime? @map("progress_inherited_at") @db.Timestamptz(3)
  lessons LessonProgress[]
  quizAttempts QuizAttempt[]
  practice PracticeResult?
  survey CourseSurveyResponse?

  @@unique([tenantId, id])
  @@unique([tenantId, userId, courseId, id], map: "enrollments_tenant_user_course_id_key")
  @@index([tenantId, userId, dueAt])
  @@index([tenantId, courseId, status])
  @@map("enrollments")
}

